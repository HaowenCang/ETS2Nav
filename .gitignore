# 依赖与构建产物
target/
bin/
obj/
node_modules/
dist/
build/

# C++ 构建中间产物（P4R Batch 5 §19）。telemetry-plugin 的两个插件 DLL 由
# build.bat 现场编译；.obj/.lib/.exp 只对构建本机有意义，且 .obj/.exp 内嵌构建机的
# 绝对路径（实测 E:\Projects\Pi\ETS2Nav\... 与 E:\Program Files\Microsoft Visual
# Studio\...）。唯一对外有意义的是 out/*.dll，故只忽略中间产物。
*.obj
*.lib
*.exp
# 注意：刻意不写 `out/`。out/ 里放的是要分发的插件 DLL，整体忽略会把唯一可用产物挡掉。

# Python 字节码缓存（P4R Batch 5 §36）。仓库内的 Python 是测试 verifier
# （verify-server-protocol.py / verify-lan-security.py），任何一次 import 或
# py_compile 都会在源文件旁生成 __pycache__/。它不是源码，且会在干净检出之外引入
# 无意义差异；本轮做卫生审计时实测它未被忽略，故补上。
__pycache__/
*.pyc

# Playwright（P4R Batch 2）：测试产物与失败快照不入库。
# dist/ 已在上方忽略——前端构建输出（vendor bundle + 可选 map.pmtiles）由
# `npm run build` 现场生成，不入库。
test-results/
playwright-report/
blob-report/
.playwright/

# 提取的游戏资源（大文件不入库）
vendor/
*.scs
extracted/

# 本地运行时数据
*.log
*.db
*.pmtiles
signal-lab-data/

# pi 工具运行时
.pi-subagents/
.pi-glla/
.pi/

# IDE
.vscode/
.idea/
data/

# 发布附件（数据集归档——经 GitHub Release 分发，不入库；生成脚本见 docs/validation/p5-closeout-2026-08.md §6）
ets2nav-dataset-*.zip
ets2nav-dataset-*.7z

# git 提交消息临时文件（多行消息经 -F 传入，避免 PowerShell 传参问题；
# 曾因 git add -A 先于删除而误入库一次，故显式忽略）
commitmsg.tmp
.git/COMMIT_MSG_TMP.txt
